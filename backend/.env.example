# Copy to backend/.env (gitignored) and fill in. Real environment variables take precedence.

# Gemini API key for POST /api/parse (AI trip input), from https://aistudio.google.com/apikey
# Leave empty for demo mode: a simple rule-based parser is used instead, no network calls.
FAST_TRAVEL_GEMINI_API_KEY=

# Optional: Gemini model. Empty = gemini-3.1-flash-lite (small and fast).
FAST_TRAVEL_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional overrides (defaults shown):
# FAST_TRAVEL_DB_PATH=fast_travel.db
# FAST_TRAVEL_CORS_ORIGINS=http://localhost:5173
# FAST_TRAVEL_NOMINATIM_ENABLED=1
